# Discord Developer Portal → Bot → Token. Never commit the real value.
DISCORD_BOT_TOKEN=

# The Discord server where committee roles live.
DISCORD_GUILD_ID=

# The KTP API owns approval and role-sync jobs.
API_BASE_URL=https://api.ugaktp.com

# A dedicated machine-to-machine secret shared only by this service and the API.
BOT_API_SECRET=

# How often to ask the API for pending role changes.
SYNC_INTERVAL_MS=30000
